{
  "manifest_version": 3,
  "name": "Base64 Right-Click Decoder",
  "version": "1.2.1",
  "description": "Decode base64 / URL / HTML / hex on any page and open, preview, or copy the result. No external decoder site needed.",
  "permissions": ["contextMenus", "activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["decode.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
